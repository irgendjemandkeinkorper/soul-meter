+func _interval_p50(count: int) -> float:
+	for _i: int in 20:
+		await process_frame
+	var xs: Array[float] = []
+	for _i: int in count:
+		var t0 := Time.get_ticks_usec()
+		await process_frame
+		xs.append((Time.get_ticks_usec() - t0) / 1000.0)
+	xs.sort()
+	return xs[xs.size() / 2]
+
+
+func _ablate() -> void:
+	var groups: Dictionary = {}
+	var visual: Dictionary = {}
+	var stack: Array[Node] = [root]
+	while not stack.is_empty():
+		var n: Node = stack.pop_back()
+		for c: Node in n.get_children():
+			stack.append(c)
+		var s: Script = n.get_script()
+		var key: String = s.resource_path if s != null else n.get_class()
+		if n.is_processing() or n.is_physics_processing():
+			if not groups.has(key):
+				groups[key] = []
+			(groups[key] as Array).append(n)
+		if n is CanvasItem and s != null and (key.ends_with("combat_overlay.gd") or key.ends_with("hostile.gd") or key.ends_with("battle_interface.gd") or key.ends_with("field_grid_layer.gd") or key.ends_with("field_hud.gd")):
+			if not visual.has(key):
+				visual[key] = []
+			(visual[key] as Array).append(n)
+	var base := await _interval_p50(150)
+	var out := {"baseline_p50_ms": base, "process": {}, "hidden": {}}
+	for key: String in groups:
+		var nodes: Array = groups[key]
+		var saved: Array = []
+		for n: Node in nodes:
+			saved.append([n.is_processing(), n.is_physics_processing()])
+			n.set_process(false)
+			n.set_physics_process(false)
+		var p := await _interval_p50(150)
+		for i: int in nodes.size():
+			if is_instance_valid(nodes[i]):
+				(nodes[i] as Node).set_process(bool(saved[i][0]))
+				(nodes[i] as Node).set_physics_process(bool(saved[i][1]))
+		out["process"][key] = {"count": nodes.size(), "p50_ms": p, "saved_ms": base - p}
+	for key: String in visual:
+		var nodes: Array = visual[key]
+		for n: CanvasItem in nodes:
+			n.set_meta(&"was_visible", n.visible)
+			n.visible = false
+		var p := await _interval_p50(150)
+		for n: CanvasItem in nodes:
+			if is_instance_valid(n):
+				n.visible = bool(n.get_meta(&"was_visible"))
+		out["hidden"][key] = {"count": nodes.size(), "p50_ms": p, "saved_ms": base - p}
+	out["baseline_after_p50_ms"] = await _interval_p50(150)
+	printerr("ABLATE " + JSON.stringify(out))
+
+
+func _phys_p50(count: int) -> Array:
+	for _i: int in 20:
+		await process_frame
+	var xs: Array[float] = []
+	var ph: Array[float] = []
+	for _i: int in count:
+		var t0 := Time.get_ticks_usec()
+		await process_frame
+		xs.append((Time.get_ticks_usec() - t0) / 1000.0)
+		ph.append(float(Performance.get_monitor(Performance.TIME_PHYSICS_PROCESS)) * 1000.0)
+	xs.sort()
+	ph.sort()
+	return [xs[xs.size() / 2], ph[ph.size() / 2]]
