[gd_scene load_steps=6 format=3]

[ext_resource type="Script" path="res://ui/flow/game_flow.gd" id="1_flow"]
[ext_resource type="Script" path="res://addons/godot_state_charts/state_chart.gd" id="2_chart"]
[ext_resource type="Script" path="res://addons/godot_state_charts/compound_state.gd" id="3_compound"]
[ext_resource type="Script" path="res://addons/godot_state_charts/atomic_state.gd" id="4_atomic"]
[ext_resource type="Script" path="res://addons/godot_state_charts/transition.gd" id="5_transition"]

[node name="GameFlow" type="Node"]
script = ExtResource("1_flow")

[node name="StateChart" type="Node" parent="."]
script = ExtResource("2_chart")

[node name="Root" type="Node" parent="StateChart"]
script = ExtResource("3_compound")
initial_state = NodePath("Boot")

[node name="Boot" type="Node" parent="StateChart/Root"]
script = ExtResource("4_atomic")

[node name="ToMenus" type="Node" parent="StateChart/Root/Boot"]
script = ExtResource("5_transition")
to = NodePath("../../Menus")
event = &"boot_done"

[node name="Menus" type="Node" parent="StateChart/Root"]
script = ExtResource("3_compound")
initial_state = NodePath("Title")

[node name="Title" type="Node" parent="StateChart/Root/Menus"]
script = ExtResource("4_atomic")

[node name="ToPlaying" type="Node" parent="StateChart/Root/Menus/Title"]
script = ExtResource("5_transition")
to = NodePath("../../../Playing")
event = &"new_game"

[node name="ToCharacterCreation" type="Node" parent="StateChart/Root/Menus/Title"]
script = ExtResource("5_transition")
to = NodePath("../../CharacterCreation")
event = &"start_chargen"

[node name="CharacterCreation" type="Node" parent="StateChart/Root/Menus"]
script = ExtResource("4_atomic")

[node name="ToPlaying" type="Node" parent="StateChart/Root/Menus/CharacterCreation"]
script = ExtResource("5_transition")
to = NodePath("../../../Playing")
event = &"new_game"

[node name="Playing" type="Node" parent="StateChart/Root"]
script = ExtResource("3_compound")
initial_state = NodePath("Loading")

[node name="Loading" type="Node" parent="StateChart/Root/Playing"]
script = ExtResource("4_atomic")

[node name="ToActive" type="Node" parent="StateChart/Root/Playing/Loading"]
script = ExtResource("5_transition")
to = NodePath("../../Active")
event = &"level_ready"

[node name="Active" type="Node" parent="StateChart/Root/Playing"]
script = ExtResource("4_atomic")

[node name="ToPaused" type="Node" parent="StateChart/Root/Playing/Active"]
script = ExtResource("5_transition")
to = NodePath("../../Paused")
event = &"pause"

[node name="ToDeploymentSlate" type="Node" parent="StateChart/Root/Playing/Active"]
script = ExtResource("5_transition")
to = NodePath("../../DeploymentSlate")
event = &"enter_battle"

[node name="ToLoading" type="Node" parent="StateChart/Root/Playing/Active"]
script = ExtResource("5_transition")
to = NodePath("../../Loading")
event = &"travel"

[node name="ToChapterComplete" type="Node" parent="StateChart/Root/Playing/Active"]
script = ExtResource("5_transition")
to = NodePath("../../ChapterComplete")
event = &"chapter_complete"

[node name="Paused" type="Node" parent="StateChart/Root/Playing"]
script = ExtResource("4_atomic")

[node name="ToActive" type="Node" parent="StateChart/Root/Playing/Paused"]
script = ExtResource("5_transition")
to = NodePath("../../Active")
event = &"resume"

[node name="ToMenus" type="Node" parent="StateChart/Root/Playing/Paused"]
script = ExtResource("5_transition")
to = NodePath("../../../Menus")
event = &"to_main_menu"

[node name="DeploymentSlate" type="Node" parent="StateChart/Root/Playing"]
script = ExtResource("4_atomic")

[node name="ToAttune" type="Node" parent="StateChart/Root/Playing/DeploymentSlate"]
script = ExtResource("5_transition")
to = NodePath("../../DeploymentAttune")
event = &"deployment_next"

[node name="DeploymentAttune" type="Node" parent="StateChart/Root/Playing"]
script = ExtResource("4_atomic")

[node name="ToLoadout" type="Node" parent="StateChart/Root/Playing/DeploymentAttune"]
script = ExtResource("5_transition")
to = NodePath("../../DeploymentLoadout")
event = &"deployment_next"

[node name="DeploymentLoadout" type="Node" parent="StateChart/Root/Playing"]
script = ExtResource("4_atomic")

[node name="ToPlace" type="Node" parent="StateChart/Root/Playing/DeploymentLoadout"]
script = ExtResource("5_transition")
to = NodePath("../../DeploymentPlace")
event = &"deployment_next"

[node name="DeploymentPlace" type="Node" parent="StateChart/Root/Playing"]
script = ExtResource("4_atomic")

[node name="ToBattle" type="Node" parent="StateChart/Root/Playing/DeploymentPlace"]
script = ExtResource("5_transition")
to = NodePath("../../Battle")
event = &"accept_slate"

[node name="Battle" type="Node" parent="StateChart/Root/Playing"]
script = ExtResource("4_atomic")

[node name="ToActive" type="Node" parent="StateChart/Root/Playing/Battle"]
script = ExtResource("5_transition")
to = NodePath("../../Active")
event = &"battle_end"

[node name="ChapterComplete" type="Node" parent="StateChart/Root/Playing"]
script = ExtResource("4_atomic")

[node name="ToActive" type="Node" parent="StateChart/Root/Playing/ChapterComplete"]
script = ExtResource("5_transition")
to = NodePath("../../Active")
event = &"continue_exploring"

[node name="ToMenus" type="Node" parent="StateChart/Root/Playing/ChapterComplete"]
script = ExtResource("5_transition")
to = NodePath("../../../Menus")
event = &"to_main_menu"
