[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://ui/hud/regions/tactical_data/tactical_data_region.gd" id="1_hud"]
[ext_resource type="Script" path="res://ui/hud/balance_arcs.gd" id="2_balance"]
[ext_resource type="Script" path="res://ui/hud/eclipse_pips.gd" id="3_pips"]

; Owner 2026-11-01: tactical data lives in the breakdown popover, so the two rows stack
; vertically and every column is as narrow as its content. Node names and paths are kept.
[node name="TacticalDataRegion" type="PanelContainer"]
theme_type_variation = &"BattleHudPanel"
script = ExtResource("1_hud")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_type_variation = &"BattleHudMargin"

[node name="Columns" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_type_variation = &"BattleHudColumn"

[node name="PrimaryRow" type="VBoxContainer" parent="Margin/Columns"]
layout_mode = 2
theme_type_variation = &"BattleHudColumn"

[node name="InitiativeColumn" type="VBoxContainer" parent="Margin/Columns/PrimaryRow"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"BattleHudColumn"

[node name="Title" type="Label" parent="Margin/Columns/PrimaryRow/InitiativeColumn"]
layout_mode = 2
theme_type_variation = &"EyebrowLabel"
text = "INITIATIVE"

[node name="Initiative" type="Label" parent="Margin/Columns/PrimaryRow/InitiativeColumn"]
layout_mode = 2
theme_type_variation = &"StatLabel"
text = "Awaiting event"
autowrap_mode = 2

[node name="BalanceColumn" type="VBoxContainer" parent="Margin/Columns/PrimaryRow"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"BattleHudColumn"

[node name="Title" type="Label" parent="Margin/Columns/PrimaryRow/BalanceColumn"]
layout_mode = 2
theme_type_variation = &"EyebrowLabel"
text = "CHAOS  /  BALANCE  /  ORDER"

[node name="BalanceValue" type="Label" parent="Margin/Columns/PrimaryRow/BalanceColumn"]
layout_mode = 2
theme_type_variation = &"StatLabel"
text = "BALANCE  0"

[node name="BalanceArcs" type="Control" parent="Margin/Columns/PrimaryRow/BalanceColumn"]
custom_minimum_size = Vector2(0, 40)
layout_mode = 2
mouse_filter = 2
script = ExtResource("2_balance")

[node name="APColumn" type="VBoxContainer" parent="Margin/Columns/PrimaryRow"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"BattleHudColumn"

[node name="Title" type="Label" parent="Margin/Columns/PrimaryRow/APColumn"]
layout_mode = 2
theme_type_variation = &"EyebrowLabel"
text = "ACTION POINTS"

[node name="APPips" type="Control" parent="Margin/Columns/PrimaryRow/APColumn"]
custom_minimum_size = Vector2(0, 22)
layout_mode = 2
mouse_filter = 2
script = ExtResource("3_pips")

[node name="APValue" type="Label" parent="Margin/Columns/PrimaryRow/APColumn"]
layout_mode = 2
theme_type_variation = &"StatLabel"
text = "AP  0 / 0"

[node name="SecondaryRow" type="VBoxContainer" parent="Margin/Columns"]
layout_mode = 2
size_flags_vertical = 3
theme_type_variation = &"BattleHudColumn"

[node name="ZonesColumn" type="VBoxContainer" parent="Margin/Columns/SecondaryRow"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"BattleHudColumn"

[node name="Title" type="Label" parent="Margin/Columns/SecondaryRow/ZonesColumn"]
layout_mode = 2
theme_type_variation = &"EyebrowLabel"
text = "ZONES"

[node name="Zones" type="Label" parent="Margin/Columns/SecondaryRow/ZonesColumn"]
layout_mode = 2
theme_type_variation = &"MutedLabel"
text = "Awaiting zone event"
autowrap_mode = 2

[node name="CheckColumn" type="VBoxContainer" parent="Margin/Columns/SecondaryRow"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"BattleHudColumn"

[node name="CheckMathToggle" type="Button" parent="Margin/Columns/SecondaryRow/CheckColumn"]
custom_minimum_size = Vector2(0, 32)
layout_mode = 2
focus_mode = 2
theme_type_variation = &"BronzeButton"
toggle_mode = true
button_pressed = true
text = "CHECK MATH  ON"

[node name="CheckMath" type="Label" parent="Margin/Columns/SecondaryRow/CheckColumn"]
visible = false
layout_mode = 2
theme_type_variation = &"StatLabel"
autowrap_mode = 2

[node name="WeaknessesColumn" type="VBoxContainer" parent="Margin/Columns/SecondaryRow"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"BattleHudColumn"

[node name="Title" type="Label" parent="Margin/Columns/SecondaryRow/WeaknessesColumn"]
layout_mode = 2
theme_type_variation = &"EyebrowLabel"
text = "DISCOVERED WEAKNESSES"

[node name="Weaknesses" type="Label" parent="Margin/Columns/SecondaryRow/WeaknessesColumn"]
layout_mode = 2
theme_type_variation = &"MutedLabel"
text = "None discovered"
autowrap_mode = 2
