; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[addons]

ss2d/version="3.3.1"

[application]

config/name="SoulMeter"
run/main_scene="res://ui/screens/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

MusicDirector="*res://audio/music_director.gd"
AppConfig="*res://addons/maaacks_game_template/base/nodes/autoloads/app_config/app_config.tscn"
SceneLoader="*res://addons/maaacks_game_template/base/nodes/autoloads/scene_loader/scene_loader.tscn"
ProjectMusicController="*res://addons/maaacks_game_template/base/nodes/autoloads/music_controller/project_music_controller.tscn"
ProjectUISoundController="*res://addons/maaacks_game_template/base/nodes/autoloads/ui_sound_controller/project_ui_sound_controller.tscn"
DialogueManager="*res://addons/dialogue_manager/dialogue_manager.gd"
PhantomCameraManager="*res://addons/phantom_camera/scripts/managers/phantom_camera_manager.gd"
GameState="*res://globals/game_state.gd"
Reputation="*res://globals/reputation.gd"
Renown="*res://globals/renown.gd"
WorldClock="*res://globals/world_clock.gd"
UIManager="*res://ui/ui_manager.gd"
GameFlow="*res://ui/flow/game_flow.tscn"
ANIMA="*uid://k2b42ydgo7l5"
Juicee="*uid://b36fwfvmmv0xc"
Pandora="*uid://bqv713p4thrli"
QuestSystem="*uid://b77kvbliweux5"
QuestRegistry="*res://globals/quest_registry.gd"
Battle="*res://globals/battle.gd"
SaveGame="*res://globals/save_game.gd"
SkillCheck="*res://globals/skill_check.gd"
CombatSpeechPresenter="*res://ui/dialogue/combat_speech_presenter.gd"
CombatStylePoints="*res://globals/combat_style_tracker.gd"
LayoutMode="*res://globals/layout_mode.gd"
PlaytestRecorder="*res://globals/playtest_recorder.gd"
DevConsole="*res://globals/dev_console.gd"

[dialogue_manager]

runtime/balloon_path="res://ui/dialogue/dialogue_balloon.tscn"
runtime/state_autoload_shortcuts=PackedStringArray("SkillCheck")

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/size/min_width=960
window/size/min_height=540

[editor_plugins]

enabled=PackedStringArray("res://addons/anima/plugin.cfg", "res://addons/dialogue_manager/plugin.cfg", "res://addons/gdUnit4/plugin.cfg", "res://addons/gloot/plugin.cfg", "res://addons/godot_state_charts/plugin.cfg", "res://addons/juicee/plugin.cfg", "res://addons/maaacks_game_template/plugin.cfg", "res://addons/pandora/plugin.cfg", "res://addons/phantom_camera/plugin.cfg", "res://addons/quest_system/plugin.cfg", "res://addons/rmsmartshape/plugin.cfg", "res://addons/soul_meter_tools/plugin.cfg")

