script = ExtResource("1_flag")
id = 3
quest_name = "The Deep Trial"
quest_description = "An empty suit has returned to its old Jawbrace post. Coiljaw needs proof that the first ledge can be held before he asks Dom to descend into the Hush."
quest_objective = "Reach the Wound lip below the Jawbrace."
