[resource]
script = ExtResource("1_side")
id = 6
quest_name = "Dishonest Water"
quest_description = "Keth Varr found honest seals around cooling water that carries the wrong residue. Dom must choose between stopping the East Arm forges and keeping the Hammer Roar alive under watch."
quest_objective = "Trace the suspect cooling-water casks."
required_flags = PackedStringArray("dom_dishonest_casks_traced")
objectives = PackedStringArray("Compare Arvek's cooper mark with the forge shutdown tally.", "Return to Keth Varr and rule on the suspect casks.")
