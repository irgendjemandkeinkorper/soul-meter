extends Node
## Placeholder pieces for walk-in buildings (owner list item 35, rulings of 2026-11-03: "Modular
## kit", "Placeholders now"). Kenney Fantasy Town models are composed into the kit's pieces at the
## kit spec and rendered with the sprite tool's camera (tools/render_isometric_sprites.gd), so
## these placeholders and the owner's later Blender captures sit on one grid. The spec:
##   - one model unit is one cell edge: a unit square on the floor is one 64 x 32 tile;
##   - a wall is 1 unit long and 4 tall; its cutaway stub is 0.5 tall; a doorway is 3 tall;
##   - a piece's pivot is on the floor at the middle of its base; a roof's is at the front corner
##     of the footprint it covers. Each piece's pivot pixel is in building_kit.json.
## Wall pieces come in two runs: `-x` runs along the ground's +x cells (screen right and down),
## `-z` along its +y cells (screen left and down).
##
## Run as a temporary autoload under Xvfb (the viewport needs a renderer), from the repo root:
##   cp project.godot /tmp/project.godot.bak
##   sed -i '/^Pandora=/a BuildingKitRender="*res://tools/render_building_kit.gd"' project.godot
##   SOUL_METER_BUILDING_KIT=1 xvfb-run -a -s "-screen 0 1280x1024x24" "$GODOT_BIN" --path .
##   cp /tmp/project.godot.bak project.godot
##   "$GODOT_BIN" --headless --path . --import
## Prints BUILDING-KIT: ok|FAILED lines; judge those, not the exit code.

const Iso := preload("res://tools/render_isometric_sprites.gd")
const RUN_ENV := "SOUL_METER_BUILDING_KIT"
const KIT := "res://assets/kenney3d/fantasy-town-kit/Models/GLB format/"
const OUT_DIR := "res://assets/generated/sprites/building-kit/"
const MANIFEST := OUT_DIR + "building_kit.json"

const WALL_TIERS := 4
const STUB_HEIGHT := 0.5
const DOOR_HEIGHT := 3
const WALL_THICKNESS := 0.2
const POST_SIZE := 0.26
const FLOOR_THICKNESS := 0.06
const ROOF_PITCH_DEGREES := 35.0
const ROOF_OVERHANG := 0.3
## Roofs to render, by footprint in cells (+x, +y). The prototype has one: the Kesselford Wayhouse.
const ROOFS: Array[Vector2i] = [Vector2i(12, 9)]
const ROOF_COLOUR := Color(0.34, 0.36, 0.4)
const GABLE_COLOUR := Color(0.47, 0.34, 0.24)
const GRADE_SATURATION := 0.7
const GRADE_VALUE := 0.62

const PIECE_VIEW := Vector2i(160, 256)
const ROOF_VIEW := Vector2i(1024, 832)

var _viewport: SubViewport
var _camera: Camera3D
var _stage: Node3D
var _log: PackedStringArray = []
var _manifest := {}


func _ready() -> void:
	if OS.get_environment(RUN_ENV).is_empty():
		return
	_run.call_deferred()


func _run() -> void:
	for i in 10:
		await get_tree().process_frame
	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(OUT_DIR))
	_create_viewport()
	var ok := true
	for run: String in ["x", "z"]:
		ok = await _piece("wall-" + run, _wall(run, false), PIECE_VIEW) and ok
		ok = await _piece("wall-window-" + run, _wall(run, true), PIECE_VIEW) and ok
		ok = await _piece("wall-stub-" + run, _stub(run), PIECE_VIEW) and ok
		ok = await _piece("lintel-" + run, _lintel(run), PIECE_VIEW) and ok
	ok = await _piece("post", _post(float(WALL_TIERS)), PIECE_VIEW) and ok
	ok = await _piece("post-stub", _post(STUB_HEIGHT), PIECE_VIEW) and ok
	ok = await _piece("floor-planks", _floor(), PIECE_VIEW) and ok
	for size: Vector2i in ROOFS:
		ok = await _piece("roof-%dx%d" % [size.x, size.y], _roof(size), ROOF_VIEW) and ok
	var manifest := {
		"generator": "tools/render_building_kit.gd",
		"note": "GENERATED by tools/render_building_kit.gd. Do not edit. Placeholder kit (item 35).",
		"spec": {
			"unit": "one cell edge", "wall_height": WALL_TIERS, "stub_height": STUB_HEIGHT,
			"door_height": DOOR_HEIGHT, "roof_pitch_degrees": ROOF_PITCH_DEGREES,
		},
		"pieces": _manifest,
	}
	var file := FileAccess.open(MANIFEST, FileAccess.WRITE)
	ok = file != null and ok
	if file != null:
		file.store_string(JSON.stringify(manifest, "\t", true) + "\n")
		file.close()
	_log.append("BUILDING-KIT: %s" % ("ok" if ok else "FAILED"))
	print("\n".join(_log))
	get_tree().quit(0 if ok else 1)


func _create_viewport() -> void:
	_viewport = SubViewport.new()
	_viewport.transparent_bg = true
	_viewport.own_world_3d = true
	_viewport.render_target_clear_mode = SubViewport.CLEAR_MODE_ALWAYS
	_viewport.render_target_update_mode = SubViewport.UPDATE_DISABLED
	_viewport.msaa_3d = Viewport.MSAA_4X
	add_child(_viewport)
	_stage = Node3D.new()
	_viewport.add_child(_stage)
	var environment := Environment.new()
	environment.background_mode = Environment.BG_COLOR
	environment.background_color = Color(0.0, 0.0, 0.0, 0.0)
	environment.ambient_light_source = Environment.AMBIENT_SOURCE_COLOR
	environment.ambient_light_color = Iso.AMBIENT_LIGHT_COLOR
	environment.ambient_light_energy = Iso.AMBIENT_LIGHT_ENERGY
	environment.reflected_light_source = Environment.REFLECTION_SOURCE_DISABLED
	var world_environment := WorldEnvironment.new()
	world_environment.environment = environment
	_viewport.add_child(world_environment)
	var sunlight := DirectionalLight3D.new()
	sunlight.rotation_degrees = Iso.SUN_ROTATION_DEGREES
	sunlight.light_color = Iso.SUN_LIGHT_COLOR
	sunlight.light_energy = Iso.SUN_LIGHT_ENERGY
	sunlight.shadow_enabled = true
	_viewport.add_child(sunlight)
	_camera = Camera3D.new()
	_camera.projection = Iso.CAMERA_PROJECTION
	_camera.near = 0.05
	_camera.far = 200.0
	_camera.current = true
	_viewport.add_child(_camera)


## Renders `piece` (its origin is the pivot) into OUT_DIR/<name>.png, cropped to its pixels.
func _piece(name: String, piece: Node3D, view: Vector2i) -> bool:
	_viewport.size = view
	_camera.size = float(view.y) / Iso.PIXELS_PER_WORLD_UNIT
	_stage.add_child(piece)
	var bounds := Iso._model_bounds(piece)
	var target := bounds.get_center()
	var direction := Vector3(
		sin(deg_to_rad(Iso.CAMERA_YAW_DEGREES)) * cos(Iso.CAMERA_PITCH_RADIANS),
		sin(Iso.CAMERA_PITCH_RADIANS),
		cos(deg_to_rad(Iso.CAMERA_YAW_DEGREES)) * cos(Iso.CAMERA_PITCH_RADIANS)
	)
	_camera.look_at_from_position(target + direction * 60.0, target, Vector3.UP)
	await get_tree().process_frame
	_viewport.render_target_update_mode = SubViewport.UPDATE_ONCE
	await RenderingServer.frame_post_draw
	var pivot := _camera.unproject_position(Vector3.ZERO)
	var image := _viewport.get_texture().get_image()
	_stage.remove_child(piece)
	piece.free()
	if image == null or image.is_empty():
		_log.append("BUILDING-KIT: FAILED %s (empty render)" % name)
		return false
	if image.get_format() != Image.FORMAT_RGBA8:
		image.convert(Image.FORMAT_RGBA8)
	var used := image.get_used_rect()
	if used.size.x == 0 or used.size.y == 0:
		_log.append("BUILDING-KIT: FAILED %s (nothing drawn)" % name)
		return false
	var touches := used.position.x == 0 or used.position.y == 0 \
		or used.end.x == view.x or used.end.y == view.y
	image = image.get_region(used)
	_grade(image)
	var path := OUT_DIR + name + ".png"
	if image.save_png(path) != OK:
		_log.append("BUILDING-KIT: FAILED %s (cannot write)" % name)
		return false
	_manifest[name] = {
		"file": name + ".png",
		"pivot": [snappedf(pivot.x - used.position.x, 0.01), snappedf(pivot.y - used.position.y, 0.01)],
		"size": [used.size.x, used.size.y],
	}
	_log.append("BUILDING-KIT: %s %s %dx%d" % ["ok" if not touches else "FAILED (clipped)", name, used.size.x, used.size.y])
	return not touches


## Brings Kenney's bright toy palette down toward the painted maps' dusk: less saturated and
## darker. PROVISIONAL, like every placeholder.
static func _grade(image: Image) -> void:
	for y in image.get_height():
		for x in image.get_width():
			var colour := image.get_pixel(x, y)
			if colour.a <= 0.0:
				continue
			var grey := colour.get_luminance()
			var graded := Color(grey, grey, grey).lerp(colour, GRADE_SATURATION) * GRADE_VALUE
			graded.a = colour.a
			image.set_pixel(x, y, graded)


## A Kenney model scaled to `size` (x along the run, y up, z across), base on the floor, centred.
func _module(model_name: String, size: Vector3) -> Node3D:
	var source := KIT + model_name + ".glb"
	var model := (load(source) as PackedScene).instantiate() as Node3D
	Iso._apply_external_colormap(model, source)
	var bounds := Iso._model_bounds(model)
	var turn := bounds.size.z > bounds.size.x * 1.5
	var holder := Node3D.new()
	var spin := Node3D.new()
	holder.add_child(spin)
	spin.add_child(model)
	model.position = Vector3(-bounds.get_center().x, -bounds.position.y, -bounds.get_center().z)
	var along := bounds.size.z if turn else bounds.size.x
	var across := bounds.size.x if turn else bounds.size.z
	if turn:
		spin.rotation.y = PI / 2.0
	holder.scale = Vector3(size.x / along, size.y / maxf(bounds.size.y, 0.001), size.z / maxf(across, 0.001))
	return holder


func _run_root(run: String) -> Node3D:
	var root := Node3D.new()
	if run == "z":
		root.rotation.y = -PI / 2.0
	return root


func _wall(run: String, window: bool) -> Node3D:
	var root := _run_root(run)
	for tier in WALL_TIERS:
		var model_name := "wall-wood-window-shutters" if window and tier == 1 else "wall-wood"
		var module := _module(model_name, Vector3(1.0, 1.0, WALL_THICKNESS))
		module.position.y = float(tier)
		root.add_child(module)
	return root


func _stub(run: String) -> Node3D:
	var root := _run_root(run)
	root.add_child(_module("wall-wood", Vector3(1.0, STUB_HEIGHT, WALL_THICKNESS)))
	return root


func _lintel(run: String) -> Node3D:
	var root := _run_root(run)
	for tier in range(DOOR_HEIGHT, WALL_TIERS):
		var module := _module("wall-wood", Vector3(1.0, 1.0, WALL_THICKNESS))
		module.position.y = float(tier)
		root.add_child(module)
	return root


func _post(height: float) -> Node3D:
	var root := Node3D.new()
	root.add_child(_module("pillar-wood", Vector3(POST_SIZE, height, POST_SIZE)))
	return root


func _floor() -> Node3D:
	var root := Node3D.new()
	var module := _module("planks", Vector3(1.0, FLOOR_THICKNESS, 1.0))
	module.position.y = -FLOOR_THICKNESS
	root.add_child(module)
	return root


## A gable roof over a footprint of `cells` (ridge along x), eaves on the wall tops. Its origin is
## the footprint's front corner (largest x and z), so the footprint runs from (-x, -z) to (0, 0).
func _roof(cells: Vector2i) -> Node3D:
	var length := float(cells.x)
	var depth := float(cells.y)
	var o := ROOF_OVERHANG
	var slope := tan(deg_to_rad(ROOF_PITCH_DEGREES))
	var eave := float(WALL_TIERS) - o * slope
	var ridge := float(WALL_TIERS) + depth * 0.5 * slope
	var mid := -depth * 0.5
	var x0 := -length - o
	var x1 := o
	var z0 := -depth - o
	var z1 := o
	var tool := SurfaceTool.new()
	tool.begin(Mesh.PRIMITIVE_TRIANGLES)
	# Front slope (toward +z) and back slope (toward -z).
	_quad(tool, Vector3(x0, eave, z1), Vector3(x1, eave, z1), Vector3(x1, ridge, mid), Vector3(x0, ridge, mid))
	_quad(tool, Vector3(x1, eave, z0), Vector3(x0, eave, z0), Vector3(x0, ridge, mid), Vector3(x1, ridge, mid))
	tool.generate_normals()
	var roof_mesh := MeshInstance3D.new()
	roof_mesh.mesh = tool.commit()
	var roof_material := StandardMaterial3D.new()
	roof_material.albedo_color = ROOF_COLOUR
	roof_material.cull_mode = BaseMaterial3D.CULL_DISABLED
	roof_mesh.material_override = roof_material
	# Gable ends fill the triangle between the wall tops and the ridge, at both x ends.
	var gable_tool := SurfaceTool.new()
	gable_tool.begin(Mesh.PRIMITIVE_TRIANGLES)
	var wall_top := float(WALL_TIERS)
	for x: float in [-length, 0.0]:
		gable_tool.add_vertex(Vector3(x, wall_top, -depth))
		gable_tool.add_vertex(Vector3(x, wall_top, 0.0))
		gable_tool.add_vertex(Vector3(x, ridge, mid))
	gable_tool.generate_normals()
	var gable_mesh := MeshInstance3D.new()
	gable_mesh.mesh = gable_tool.commit()
	var gable_material := StandardMaterial3D.new()
	gable_material.albedo_color = GABLE_COLOUR
	gable_material.cull_mode = BaseMaterial3D.CULL_DISABLED
	gable_mesh.material_override = gable_material
	var root := Node3D.new()
	root.add_child(roof_mesh)
	root.add_child(gable_mesh)
	# Shingle courses: thin darker strips across each slope.
	var course_material := StandardMaterial3D.new()
	course_material.albedo_color = ROOF_COLOUR.darkened(0.25)
	for side: float in [1.0, -1.0]:
		for step in range(1, 6):
			var t := float(step) / 6.0
			var z := lerpf(z1 if side > 0.0 else z0, mid, t)
			var y := lerpf(eave, ridge, t) + 0.02
			var strip := MeshInstance3D.new()
			var box := BoxMesh.new()
			box.size = Vector3(x1 - x0, 0.04, 0.06)
			strip.mesh = box
			strip.material_override = course_material
			strip.position = Vector3((x0 + x1) * 0.5, y, z)
			root.add_child(strip)
	return root


static func _quad(tool: SurfaceTool, a: Vector3, b: Vector3, c: Vector3, d: Vector3) -> void:
	for point: Vector3 in [a, b, c, a, c, d]:
		tool.add_vertex(point)
