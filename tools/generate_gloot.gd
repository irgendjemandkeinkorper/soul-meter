extends Node
## generate_gloot.gd — the Pandora → GLoot one-way sync generator (see
## docs/godot-architecture.md, "Pandora → GLoot sync spec").
##
## Pandora OWNS item data. This emits the generated artifacts (committed, never
## hand-edited):
##   res://data/generated/gloot_prototree.json  — GLoot protoset (keys: size /
##       max_stack_size / weight — GLoot's own constraint keys — plus name,
##       description, equip_slot, rarity, flavour)
##   res://data/generated/item_ids.gd           — ItemIds constants; no literal
##       item path strings in code, ever
##   res://data/generated/items.pot             — gettext template of English
##       source strings. Keys are derived (never stored): ITEM_<PATH>_NAME/_DESC
##       where <PATH> is the prototype path uppercased — renames surface as
##       stale strings for translators, which is intended.
##
## Run ways:
##   - Editor: Project > Tools > Regenerate GLoot prototypes (addons/soul_meter_tools)
##   - Headless: register as temp autoload and run once (see DEPENDENCIES.md)
##   - Drift check (CI/pre-commit): run with env SOUL_METER_DRIFT_CHECK=1 —
##     exits non-zero if committed artifacts differ from a fresh generation.

const OUT_DIR := "res://data/generated"
const PROTOTREE_PATH := OUT_DIR + "/gloot_prototree.json"
const ITEM_IDS_PATH := OUT_DIR + "/item_ids.gd"
const POT_PATH := OUT_DIR + "/items.pot"
const GENERATED_HEADER := "GENERATED by tools/generate_gloot.gd from data.pandora — DO NOT EDIT. Change the Pandora entity and regenerate."


func _ready() -> void:
	await get_tree().process_frame
	if not Pandora.is_loaded():
		Pandora.load_data()
	var check_only: bool = OS.get_environment("SOUL_METER_DRIFT_CHECK") == "1"
	var result := generate(check_only)
	if check_only:
		if result["drift"]:
			printerr("GLOOT-GEN: DRIFT — committed artifacts differ from Pandora. Regenerate and commit.")
			get_tree().quit(1)
			return
		print("GLOOT-GEN: no drift.")
	else:
		print("GLOOT-GEN: wrote %d prototypes -> %s" % [result["count"], PROTOTREE_PATH])
	get_tree().quit()


## Walks the Pandora Items tree and builds all three artifacts.
## Returns {count, drift} — when check_only, nothing is written.
static func generate(check_only: bool = false) -> Dictionary:
	var items_root: PandoraCategory = null
	for root in Pandora.get_all_roots():
		if root.get_entity_name() == "Items":
			items_root = root
			break
	assert(items_root != null, "Pandora has no Items root — run tools/seed_pandora.gd first")

	# Collect entities with their category-chain path below Items.
	var protos := {}  # path -> properties dict
	for ent: PandoraEntity in Pandora.get_all_entities(items_root):
		if ent is PandoraCategory:
			continue
		var chain := PackedStringArray()
		var cat := Pandora.get_category(ent.get_category_id())
		while cat != null and cat.get_entity_id() != items_root.get_entity_id():
			chain.insert(0, _slug(cat.get_entity_name()))
			cat = Pandora.get_category(cat.get_category_id()) if cat.get_category_id() else null
		chain.append(_slug(ent.get_entity_name()))
		var path := "/".join(chain)

		var props := {
			"name": ent.get_string("Display Name"),
			"description": ent.get_string("Description"),
			"size": var_to_str(ent.get_vector2i("Grid Size")),
			"max_stack_size": ent.get_integer("Max Stack Size"),
			"weight": ent.get_float("Weight"),
			"rarity": ent.get_string("Rarity"),
			"flavour": ent.get_string("Flavour"),
		}
		var slot := ent.get_string("Equip Slot")
		if not slot.is_empty():
			props["equip_slot"] = slot
		protos[path] = props

	var paths := protos.keys()
	paths.sort()  # deterministic output — required for the drift check

	# --- artifact 1: the GLoot protoset JSON ---
	var ordered := {}
	for p in paths:
		ordered[p] = protos[p]
	var json_text := JSON.stringify(ordered, "  ", false) + "\n"

	# --- artifact 2: ItemIds constants ---
	var ids_text := "# %s\nclass_name ItemIds\n\n" % GENERATED_HEADER
	for p: String in paths:
		ids_text += "const %s := \"%s\"\n" % [p.to_upper().replace("/", "_").replace("-", "_"), p]

	# --- artifact 3: gettext template of English source strings ---
	var pot := "# %s\nmsgid \"\"\nmsgstr \"\"\n\"Project-Id-Version: SoulMeter\\n\"\n\"Content-Type: text/plain; charset=UTF-8\\n\"\n\n" % GENERATED_HEADER
	for p: String in paths:
		var key := p.to_upper().replace("/", "_").replace("-", "_")
		pot += "#. %s — display name\nmsgctxt \"ITEM_%s_NAME\"\nmsgid \"%s\"\nmsgstr \"\"\n\n" % [p, key, _po_escape(protos[p]["name"])]
		pot += "#. %s — description\nmsgctxt \"ITEM_%s_DESC\"\nmsgid \"%s\"\nmsgstr \"\"\n\n" % [p, key, _po_escape(protos[p]["description"])]

	var drift := _differs(PROTOTREE_PATH, json_text) \
		or _differs(ITEM_IDS_PATH, ids_text) \
		or _differs(POT_PATH, pot)

	if not check_only:
		DirAccess.make_dir_recursive_absolute(OUT_DIR)
		_write(PROTOTREE_PATH, json_text)
		_write(ITEM_IDS_PATH, ids_text)
		_write(POT_PATH, pot)

	return {"count": paths.size(), "drift": drift}


static func _slug(name: String) -> String:
	var s := name.to_lower()
	for pair in [["'", ""], ["’", ""], [" ", "_"], ["-", "_"]]:
		s = s.replace(pair[0], pair[1])
	return s


static func _po_escape(s: String) -> String:
	return s.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n")


static func _write(path: String, text: String) -> void:
	var f := FileAccess.open(path, FileAccess.WRITE)
	f.store_string(text)
	f.close()


static func _differs(path: String, text: String) -> bool:
	if not FileAccess.file_exists(path):
		return true
	return FileAccess.get_file_as_string(path) != text
