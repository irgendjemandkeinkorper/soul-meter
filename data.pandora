			{
				"_category_id": "150.0",
				"_icon_color": "ffffff00",
				"_id": "170.0",
				"_index": 0,
				"_name": "Dorthkor Dead Muster",
				"_property_overrides": {
					"Combatant Ids": {
						"type": "string",
						"value": "mustered-bloodbellow"
					},
					"Context Actions": {
						"type": "string",
						"value": "[{\"display_name\":\"Speak Its Muster-Name\",\"id\":\"speak-muster-name\",\"lock_reason\":\"Requires Order +50 and 3 Soul to break the binding.\",\"maximum_balance\":100,\"minimum_balance\":50,\"minimum_enemy_rounds\":0,\"outcome_id\":\"named\",\"soul_cost\":3.0},{\"display_name\":\"Release the Bound Soldier\",\"id\":\"release-bound-soldier\",\"lock_reason\":\"Survive one enemy round, then hold Balance between -20 and +20.\",\"maximum_balance\":20,\"minimum_balance\":-20,\"minimum_enemy_rounds\":1,\"outcome_id\":\"released\",\"soul_cost\":0.0}]"
					},
					"Default Outcome": {
						"type": "string",
						"value": "slain"
					},
					"Defeated Flag": {
						"type": "string",
						"value": "defeated_mustered_dead"
					},
					"Display Name": {
						"type": "string",
						"value": "Dorthkor Dead Muster"
					},
					"Encounter Id": {
						"type": "string",
						"value": "dorthkor-muster"
					},
					"Loss Cause": {
						"type": "string",
						"value": ""
					},
					"Loss Delta": {
						"type": "float",
						"value": 0.0
					},
					"Loss Faction": {
						"type": "string",
						"value": ""
					},
					"Outcomes": {
						"type": "string",
						"value": "{\"named\":{\"cause\":\"Broke the Bloodbellow binding by speaking its muster-name\",\"delta\":5.0,\"faction\":\"ironbrand-sentinels\",\"flags\":{\"dorthkor_muster_cause\":\"$cause\",\"dorthkor_muster_outcome\":\"$outcome_id\"},\"message\":\"Its muster-name answers. The binding splits and the armor empties.\"},\"released\":{\"cause\":\"Released the soldier bound inside the Bloodbellow muster\",\"delta\":5.0,\"faction\":\"ironbrand-sentinels\",\"flags\":{\"dorthkor_muster_cause\":\"$cause\",\"dorthkor_muster_outcome\":\"$outcome_id\"},\"message\":\"The held center opens a way out. The soldier's soul leaves the armor.\"},\"slain\":{\"cause\":\"Destroyed the Mustered Bloodbellow by force\",\"delta\":5.0,\"faction\":\"ironbrand-sentinels\",\"flags\":{\"dorthkor_muster_cause\":\"$cause\",\"dorthkor_muster_outcome\":\"$outcome_id\"},\"message\":\"The Bloodbellow falls, its borrowed cadence cut short.\"}}"
					},
					"Win Cause": {
						"type": "string",
						"value": "Stopped a dead soldier answering Dom's muster"
					},
					"Win Delta": {
						"type": "float",
						"value": 5.0
					},
					"Win Faction": {
						"type": "string",
						"value": "ironbrand-sentinels"
					}
				}
			},
